@model List<CatcheModel>
@{
    ViewData["Title"] = "Συλλήψεις";
}

<div class="container">
    <h1 class="display-4 text-center mb-5">Συλλήψεις</h1>
    
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var c in Model) {
            <div class="col">
                <div class="card h-100 shadow catch-card">
                    <img src="images/@c.Image" class="card-img-top catch-image" alt="Σύλληψη" 
                         onclick="showImage('images/@c.Image')" />
                    <div class="card-body">
                        <h5 class="card-title">@c.FishTime.ToString("d MMMM yyyy")</h5>
                        <p class="card-text">@c.FishTime.ToString("HH:mm")</p>
                        
                        <div class="weather-stats">
                            <!-- Θερμοκρασία -->
                            <div class="mb-2">
                                <i class="fas fa-temperature-high weather-icon text-danger"></i>
                                <span>@(c.Whether?.AirTemperature ?? 0)°C</span>
                                <small class="text-muted">(Νερό: @(c.Whether?.waterTemperature ?? 0)°C)</small>
                            </div>
                            
                            <!-- Νεφοκάλυψη -->
                            <div class="mb-2">
                                @{
                                    var cloudCover = c.Whether?.CloudCover ?? 0;
                                    var cloudIcon = cloudCover switch {
                                        <= 20 => "fas fa-sun",
                                        <= 50 => "fas fa-cloud-sun",
                                        _ => "fas fa-cloud"
                                    };
                                }
                                <i class="@cloudIcon weather-icon text-warning"></i>
                                <span>@(c.Whether?.CloudCover ?? 0)%</span>
                            </div>
                            
                            <!-- Άνεμος -->
                            <div class="mb-2">
                                <i class="fas fa-location-arrow weather-icon text-primary wind-direction" 
                                   style="transform: rotate(@(c.Whether?.windDirection ?? 0)deg)"></i>
                                @{
                                    var windSpeed = c.Whether?.windSpeed ?? 0;
                                }
                                <span class="wind-info" data-wind-speed="@windSpeed"></span>
                            </div>
                            
                            <!-- Παλίρροια -->
                            <div class="mb-2">
                                <i class="fas fa-water weather-icon text-info"></i>
                                <span>@(c.Tide?.Type ?? "N/A") (@Math.Round(c.Tide?.Height ?? 0, 2)m)</span>
                            </div>

                            <!-- Φάση Φεγγαριού -->
                            @if (c.MoonPhase.HasValue)
                            {
                                <div class="mb-2">
                                    @{
                                        var moonIcon = c.MoonPhase.Value switch {
                                            <= 0.05 or >= 0.95 => "mdi mdi-moon-new",           // New Moon
                                            > 0.05 and <= 0.20 => "mdi mdi-moon-waxing-crescent", // Waxing Crescent
                                            > 0.20 and <= 0.30 => "mdi mdi-moon-first-quarter",   // First Quarter
                                            > 0.30 and <= 0.45 => "mdi mdi-moon-waxing-gibbous",  // Waxing Gibbous
                                            > 0.45 and <= 0.55 => "mdi mdi-moon-full",            // Full Moon
                                            > 0.55 and <= 0.70 => "mdi mdi-moon-waning-gibbous",  // Waning Gibbous
                                            > 0.70 and <= 0.80 => "mdi mdi-moon-last-quarter",    // Last Quarter
                                            _ => "mdi mdi-moon-waning-crescent"                   // Waning Crescent
                                        };
                                        var moonPhaseText = c.MoonPhase.Value switch {
                                            <= 0.05 or >= 0.95 => "Νέα Σελήνη",
                                            > 0.05 and <= 0.20 => "Αύξων Μηνίσκος",
                                            > 0.20 and <= 0.30 => "Πρώτο Τέταρτο",
                                            > 0.30 and <= 0.45 => "Αύξων Αμφίκυρτος",
                                            > 0.45 and <= 0.55 => "Πανσέληνος",
                                            > 0.55 and <= 0.70 => "Φθίνων Αμφίκυρτος",
                                            > 0.70 and <= 0.80 => "Τελευταίο Τέταρτο",
                                            _ => "Φθίνων Μηνίσκος"
                                        };
                                    }
                                    <i class="@moonIcon weather-icon text-warning"></i>
                                    <span>@moonPhaseText (@Math.Round(c.MoonPhase.Value * 100)%)</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- Modal για μεγέθυνση εικόνας -->
<div id="imageModal" class="img-modal" onclick="hideModal()">
    <span class="close">&times;</span>
    <img id="modalImage" class="modal-content">
</div>

@section Scripts {
    <script>
        function showImage(src) {
            const modal = document.getElementById('imageModal');
            const modalImg = document.getElementById('modalImage');
            modal.style.display = "block";
            modalImg.src = src;
        }
        
        function hideModal() {
            document.getElementById('imageModal').style.display = "none";
        }
        
        // Κλείσιμο modal με το πλήκτρο ESC
        document.addEventListener('keydown', function(event) {
            if (event.key === "Escape") {
                hideModal();
            }
        });

        function knotsToBeaufort(knots) {
            if (knots < 1) return 0;
            if (knots < 4) return 1;
            if (knots < 7) return 2;
            if (knots < 11) return 3;
            if (knots < 17) return 4;
            if (knots < 22) return 5;
            if (knots < 28) return 6;
            if (knots < 34) return 7;
            if (knots < 41) return 8;
            if (knots < 48) return 9;
            if (knots < 56) return 10;
            if (knots < 64) return 11;
            return 12;
        }
        
        function getBeaufortDescription(beaufort) {
            const descriptions = {
                0: "Άπνοια",
                1: "Σχεδόν Άπνοια",
                2: "Πολύ Ασθενής",
                3: "Ασθενής",
                4: "Μέτριος",
                5: "Λαμπρός",
                6: "Ισχυρός",
                7: "Σφοδρός",
                8: "Θυελλώδης",
                9: "Θύελλα",
                10: "Ισχυρή Θύελλα",
                11: "Σφοδρή Θύελλα",
                12: "Τυφώνας"
            };
            return descriptions[beaufort];
        }

        // Ενημέρωση όλων των ενδείξεων ανέμου
        document.addEventListener('DOMContentLoaded', function() {
            document.querySelectorAll('.wind-info').forEach(function(element) {
                const knots = parseFloat(element.dataset.windSpeed);
                const beaufort = knotsToBeaufort(knots);
                const description = getBeaufortDescription(beaufort);
                element.textContent = `${description}, ${beaufort} Μποφόρ (${knots} knots)`;
            });
        });
    </script>
}